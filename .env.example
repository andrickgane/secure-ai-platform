ACP_API_KEY=CHANGE_ME
ACP_ENVIRONMENT=development
ACP_CATALOG_PATH=../catalog

ACP_VLLM_BASE_URL=http://inference-runtime.internal:8000
ACP_VLLM_API_KEY=CHANGE_ME

ACP_KUBERNETES_NAMESPACE=ai-workloads
ACP_KUBERNETES_MODE=kubeconfig
ACP_KUBECONFIG_PATH=/path/to/.kube/config

ACP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_platform

ACP_JWT_SECRET_KEY=CHANGE_ME
ACP_JWT_ALGORITHM=HS256
ACP_JWT_ACCESS_TOKEN_MINUTES=60

ACP_REGISTRY_USERNAME=CHANGE_ME
ACP_REGISTRY_PASSWORD=CHANGE_ME
ACP_REGISTRY_PLAIN_HTTP=true
ACP_REGISTRY_INSECURE=true

ACP_COSIGN_PUBLIC_KEY=/etc/ai-platform/trust/cosign.pub
